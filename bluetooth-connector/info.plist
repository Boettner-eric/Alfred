				<key>script</key>
				<string>on run argv
  	set bundleID to (system attribute "alfred_workflow_bundleid")
	set airpodsMac to item 2 of argv
	set airpodsName to item 3 of argv

	tell application id "com.runningwithcrayons.Alfred"
    		set configuration "AIRPODS_MAC" to value airpodsMac in workflow bundleID
		set configuration "AIRPODS_NAME" to value airpodsName in workflow bundleID
	end tell
end run</string>
