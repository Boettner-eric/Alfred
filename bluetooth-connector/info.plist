				<key>script</key>
				<string>if [ $1 = "connect" ]
then
  /opt/homebrew/bin/BluetoothConnector --connect $2
  sleep 5
  /opt/homebrew/bin/SwitchAudioSource -t input -s "$input"  
  /opt/homebrew/bin/SwitchAudioSource -t output -s "$3"
  
else
  /opt/homebrew/bin/BluetoothConnector --disconnect $2
fi</string>
